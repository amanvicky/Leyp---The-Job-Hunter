# Required -- the server refuses to start without these.
# A hash of your password, never the password. Make one with: npm run hash-password -- <password>
APP_PASSWORD=
# Signs sessions and encrypts stored secrets. At least 32 random characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leyp"

# Test databases (each must end in _test / _e2e)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leyp_test"
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leyp_e2e"
